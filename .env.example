# ============================================================================
# LA Sales Academy — Production Environment Variables
# ============================================================================

# Server Configuration
NODE_ENV=production
PORT=80
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://salesacademy.ffs.my.id

# Security & Authentication
JWT_ACCESS_SECRET=la-sales-academy-prod-jwt-access-secret-2026-lintasarta
JWT_REFRESH_SECRET=la-sales-academy-prod-jwt-refresh-secret-2026-lintasarta

# Database Persistence
# Default: embedded persistent SQLite via Node native sqlite (zero external dependencies)
SQLITE_PATH=./data/salesacademy.db
# Optional: PostgreSQL connection URL for multi-container enterprise deployment
# DATABASE_URL=postgresql://salesacademy:salesacademy_secret@postgres:5432/salesacademy

# ============================================================================
# Tanya AI — Multi-Provider LLM & RAG Configuration
# Supported providers: "deterministic" | "gemini" | "openai" | "openai-compatible"
# Can also be configured dynamically at runtime via the Admin Studio UI (/admin)
# ============================================================================
AI_PROVIDER=deterministic

# Option A: Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option B: OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option C: OpenAI-Compatible API (Cloudeka Deka LLM, vLLM, Ollama, LiteLLM, OpenRouter)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

